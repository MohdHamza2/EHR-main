# Database
DATABASE_URL="postgresql://user:password@localhost:5432/metapharsic_ehr"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Application
APP_NAME="Metapharsic Lifesciences EHR"
APP_URL="http://localhost:3000"

# FHIR Configuration
FHIR_VERSION="R4"
FHIR_BASE_URL="/api/fhir"

# AI/ML Services (future)
OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""

# File Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="10485760"

# Email (optional)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""

# Environment
NODE_ENV="development"
